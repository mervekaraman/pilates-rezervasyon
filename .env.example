# ── Uygulama ───────────────────────────────────────────────
# E-postalardaki bağlantılar bu adrese göre oluşturulur.
APP_URL=http://localhost:3040

# ── Veritabanı ─────────────────────────────────────────────
# Boş bırakılırsa yerelde gömülü PostgreSQL (PGlite) ./data klasöründe çalışır ve demo verisiyle dolar.
# Canlıda bir PostgreSQL adresi verin (ör. Supabase › Project Settings › Database › Connection pooling):
# DATABASE_URL=postgresql://postgres.xxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Yerel demo verisini kapatmak için: SEED_DEMO=false
SEED_DEMO=true

# ── Eğitmen kaydı ──────────────────────────────────────────
# Kayıt formunda bu kodu giren kişi eğitmen hesabı açar. Boş bırakılırsa eğitmen kaydı kapalıdır.
TRAINER_INVITE_CODE=

# ── E-posta (SMTP) ─────────────────────────────────────────
# Boş bırakılırsa e-postalar gönderilmez; geliştirmede /gelistirici/e-postalar sayfasında görünür.
# Gmail örneği: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=adres@gmail.com, SMTP_PASSWORD=<uygulama şifresi>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Smeda Pilates <bildirim@ornek.com>"

# ── Telefon bildirimleri (Web Push, ücretsiz) ──────────────
# Boşsa özellik kapalıdır. Anahtar üretmek için: npx web-push generate-vapid-keys
# Yalnızca https üzerinde (ve localhost'ta) çalışır; iPhone'da site ana ekrana eklenmelidir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İletişim adresi gerçek bir e-posta olmalı: Apple, .test/.local gibi adreslerle gelen bildirimleri reddeder.
VAPID_SUBJECT=mailto:

# ── Stüdyo iletişim bilgileri (boş olanlar sitede gösterilmez) ──
STUDIO_ADDRESS=
STUDIO_PHONE=
STUDIO_EMAIL=
STUDIO_INSTAGRAM=
